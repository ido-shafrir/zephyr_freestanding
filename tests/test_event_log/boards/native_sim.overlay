/* Overlay for native_sim — add an event_log_partition to the simulated flash */

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		event_log_partition: partition@100000 {
			label = "event-log";
			reg = <0x100000 0x40000>; /* 256 KB */
		};
	};
};
