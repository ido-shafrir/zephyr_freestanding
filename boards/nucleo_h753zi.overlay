/*
 * Application board overlay for nucleo_h753zi
 *
 * Replaces the default flash partition layout with an MCUboot-compatible
 * layout that includes:
 *   - a 256 KB storage partition for ZMS persistent settings, and
 *   - a 256 KB event-log partition (FCB ring buffer for event_log.c).
 *
 * Both sit outside the MCUboot swap area, so persistent state and event
 * history survive firmware updates.
 *
 * Flash layout (STM32H753 dual-bank, 2 MB total):
 *   0x08000000  boot_partition       128 KB  (MCUboot)
 *   0x08020000  slot0_partition      640 KB  (primary app image, bank 1)
 *   0x080C0000  event_log_partition  256 KB  (FCB ring, 2 x 128 KB sectors)
 *   0x08100000  slot1_partition      640 KB  (secondary image, bank 2 start)
 *   0x081A0000  scratch_partition    128 KB  (MCUboot swap scratch)
 *   0x081C0000  storage_partition    256 KB  (ZMS persistent settings)
 *                                    -------
 *                                    2048 KB total
 *
 * Slot1 deliberately starts at 0x100000 (bank 2) so MCUboot swaps stay
 * within a single bank's erase domain. The event-log partition fills the
 * tail of bank 1 between slot0 and the bank boundary.
 *
 * This overlay must match sysbuild/mcuboot/boards/nucleo_h753zi.overlay.
 */

/* Delete the base board's default partition nodes */
&flash0 {
    partitions {
        /delete-node/ partition@20000;  /* old slot0 */
        /delete-node/ partition@60000;  /* old slot1 */
        /delete-node/ partition@c0000;  /* old storage */

        /* Primary app image: 640 KB (5 x 128 KB sectors) */
        slot0_partition: partition@20000 {
            label = "image-0";
            reg = <0x00020000 DT_SIZE_K(640)>;
        };

        /* Event log FCB ring: 256 KB (2 x 128 KB sectors), tail of bank 1 */
        event_log_partition: partition@c0000 {
            label = "event-log";
            reg = <0x000C0000 DT_SIZE_K(256)>;
        };

        /* Secondary / upgrade image: 640 KB (bank 2 start) */
        slot1_partition: partition@100000 {
            label = "image-1";
            reg = <0x00100000 DT_SIZE_K(640)>;
        };

        /* MCUboot swap scratch: 128 KB */
        scratch_partition: partition@1a0000 {
            label = "image-scratch";
            reg = <0x001A0000 DT_SIZE_K(128)>;
        };

        /* ZMS persistent settings: 256 KB (outside MCUboot swap area) */
        storage_partition: partition@1c0000 {
            label = "storage";
            reg = <0x001C0000 DT_SIZE_K(256)>;
        };
    };
};

/* Point the settings subsystem at the storage partition */
/ {
    chosen {
        zephyr,settings-partition = &storage_partition;
    };
};
