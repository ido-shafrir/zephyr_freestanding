/*
 * Application board overlay for nucleo_h753zi
 *
 * Replaces the default flash partition layout with an MCUboot-compatible
 * layout that includes a 256 KB storage partition for ZMS persistent
 * settings. The storage partition sits outside the MCUboot swap area,
 * so config data survives firmware updates.
 *
 * Flash layout (STM32H753 dual-bank, 2 MB total):
 *   0x08000000  boot_partition     128 KB  (MCUboot)
 *   0x08020000  slot0_partition    768 KB  (primary app image)
 *   0x08100000  slot1_partition    768 KB  (secondary / upgrade image)
 *   0x081C0000  scratch_partition  128 KB  (MCUboot swap scratch)
 *   0x081E0000  storage_partition  256 KB  (ZMS persistent settings)
 *                                  -------
 *                                  2048 KB total
 *
 * This overlay must match sysbuild/mcuboot/boards/nucleo_h753zi.overlay.
 */

/* Delete the base board's default partition nodes */
&flash0 {
    partitions {
        /delete-node/ partition@20000;  /* old slot0 */
        /delete-node/ partition@60000;  /* old slot1 */
        /delete-node/ partition@c0000;  /* old storage */

        /* Primary app image: 768 KB (6 x 128 KB sectors) */
        slot0_partition: partition@20000 {
            label = "image-0";
            reg = <0x00020000 DT_SIZE_K(768)>;
        };

        /* Secondary / upgrade image: 768 KB (bank 2 start) */
        slot1_partition: partition@100000 {
            label = "image-1";
            reg = <0x00100000 DT_SIZE_K(768)>;
        };

        /* MCUboot swap scratch: 128 KB */
        scratch_partition: partition@1c0000 {
            label = "image-scratch";
            reg = <0x001C0000 DT_SIZE_K(128)>;
        };

        /* ZMS persistent settings: 256 KB (outside MCUboot swap area) */
        storage_partition: partition@1e0000 {
            label = "storage";
            reg = <0x001E0000 DT_SIZE_K(256)>;
        };
    };
};

/* Point the settings subsystem at the storage partition */
/ {
    chosen {
        zephyr,settings-partition = &storage_partition;
    };
};
