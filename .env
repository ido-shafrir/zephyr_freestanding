# =============================================================================
# Zephyr Freestanding Application – Environment Configuration
# =============================================================================
# This file defines environment variables used by west, CMake, and the Zephyr
# build system. Source it before building, or let your IDE/tooling load it.
#
#   Linux/macOS:  set -a && source .env && set +a
#   PowerShell:   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]+)=(.*)') { [System.Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim(), 'Process') } }
# =============================================================================

# --- Zephyr Base -----------------------------------------------------------
# Path to the Zephyr kernel source tree (populated after `west update`).
# Adjust if your workspace layout differs.
ZEPHYR_BASE=C:\STM32h753\zephyrproject

# --- Board -----------------------------------------------------------------
# Default target board. Override per-build with `west build -b <board>`.
BOARD=nucleo_h753zi

# --- Toolchain -------------------------------------------------------------
# Toolchain variant: zephyr, gnuarmemb, llvm, cross-compile, etc.
ZEPHYR_TOOLCHAIN_VARIANT=zephyr

# Path to the Zephyr SDK installation (used when ZEPHYR_TOOLCHAIN_VARIANT=zephyr).
# Update this to match your local SDK install location.
ZEPHYR_SDK_INSTALL_DIR=C:\Users\idosh\zephyr-sdk-1.0.1

# Uncomment below if using GNU Arm Embedded toolchain instead of the Zephyr SDK:
# ZEPHYR_TOOLCHAIN_VARIANT=gnuarmemb
# GNUARMEMB_TOOLCHAIN_PATH=C:/gcc-arm-none-eabi

# --- Build Defaults --------------------------------------------------------
# West build directory (relative to workspace root).
BUILD_DIR=build

# CMake generator (Ninja is recommended).
CMAKE_GENERATOR=Ninja

# --- Extra CMake / Kconfig --------------------------------------------------
# Additional Kconfig fragment files (semicolon-separated).
# OVERLAY_CONFIG=debug.conf;custom.conf

# DTS overlay files (semicolon-separated).
# DTC_OVERLAY_FILE=app.overlay

# Extra CMake arguments passed to every build.
# EXTRA_CMAKE_ARGS=-DCONFIG_LOG=y
